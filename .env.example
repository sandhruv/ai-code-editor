# --- Server (never expose these to the browser) ---
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Optional: override the Groq model (defaults to a currently available code-capable model).
# List live models: curl https://api.groq.com/openai/v1/models -H "Authorization: Bearer $GROQ_API_KEY"
GROQ_MODEL=qwen/qwen3.8-27b

# Optional: max tokens for one completion (default 128)
COMPLETION_MAX_TOKENS=128

# Optional: server port (default 8787)
PORT=8787

# --- Client (Vite: must be prefixed with VITE_) ---
# Your browser calls the backend through this URL during development.
VITE_API_BASE=http://localhost:8787
